{
  "name": "webcapsule",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "fixtures:generate": "pnpm build && node scripts/generate-capsule-fixtures.mjs",
    "fixtures:check": "pnpm build && node scripts/check-capsule-fixtures.mjs",
    "android:compile": "packages/react-native-webcapsule/android/gradlew -p packages/react-native-webcapsule/android compileDebugKotlin",
    "android:test": "packages/react-native-webcapsule/android/gradlew -p packages/react-native-webcapsule/android testDebugUnitTest",
    "android:assemble": "packages/react-native-webcapsule/android/gradlew -p packages/react-native-webcapsule/android assembleRelease",
    "android:connected": "packages/react-native-webcapsule/android/gradlew -p packages/react-native-webcapsule/android connectedDebugAndroidTest",
    "android:package-check": "pnpm --filter @webcapsule/react-native test -- package-boundary",
    "ios:test": "pnpm --filter @webcapsule/react-native ios:test",
    "test:android": "pnpm android:test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
